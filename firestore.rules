rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每位登入的使用者只能讀寫自己的資料
    match /users/{uid}/data/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && (doc == 'settings' || doc == 'meta' || doc == 'boards')
                            // 盤面文件：boards 必須是 map，且最多 60 個盤面（目前約 12 個）
                            && (doc != 'boards' || (request.resource.data.boards is map && request.resource.data.boards.size() <= 60));
    }
    match /users/{uid}/book/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.items is list
                            && request.resource.data.items.size() <= 500;
    }
  }
}
